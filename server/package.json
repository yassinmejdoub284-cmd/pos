{
  "name": "pos-patisserie-server",
  "version": "1.0.0",
  "description": "Tunisian Pâtisserie POS System Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js --host 0.0.0.0",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:push": "prisma db push",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "build:exe": "pkg src/index.js --config pkg.config.json --output ../desktop/sidecar/pos-server.exe"
  },
  "keywords": [
    "pos",
    "patisserie",
    "tunisia",
    "inventory",
    "sales"
  ],
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.34.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "@yao-pkg/pkg": "^6.6.0",
    "prisma": "^6.15.0",
    "supertest": "^6.3.3",
    "vitest": "^1.0.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
