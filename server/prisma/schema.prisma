generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  username                 String                    @unique @db.VarChar(50)
  email                    String                    @unique @db.VarChar(100)
  passwordHash             String                    @map("password_hash") @db.VarChar(255)
  firstName                String                    @map("first_name") @db.VarChar(50)
  lastName                 String                    @map("last_name") @db.VarChar(50)
  role                     String                    @db.VarChar(50)
  depotId                  Int?                      @map("depot_id")
  isActive                 Boolean                   @default(true) @map("is_active")
  lastLogin                DateTime?                 @map("last_login")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  pin                      String                    @db.VarChar(8)
  token                    String?                   @unique @db.VarChar(50)
  auditLogs                AuditLog[]
  cashMovements            CashMovement[]
  approvedChanges          ChangeRequest[]           @relation("ApprovedBy")
  requestedChanges         ChangeRequest[]           @relation("RequestedBy")
  debtTransactions         ClientDebtTransaction[]
  managedDepot             Depot?                    @relation("DepotManager")
  documentStatusHistory    DocumentStatusHistory[]
  approvedExpenses         Expense[]                 @relation("ExpenseApprover")
  paidExpenses             Expense[]                 @relation("ExpensePayer")
  rejectedExpenses         Expense[]                 @relation("ExpenseRejecter")
  expenses                 Expense[]                 @relation("ExpenseCreator")
  inventoryItemsCounted    InventoryItem[]           @relation("InventoryCounter")
  inventorySessionsClosed  InventorySession[]        @relation("InventoryCloser")
  inventorySessionsPosted  InventorySession[]        @relation("InventoryPoster")
  inventorySessionsStarted InventorySession[]        @relation("InventoryStarter")
  approvedReturns          ReturnRequest[]           @relation("ReturnApprovedBy")
  requestedReturns         ReturnRequest[]           @relation("ReturnRequestedBy")
  approvedInvoiceRequests        InvoiceRequest[]          @relation("InvoiceRequestApprover")
  createdInvoiceRequests         InvoiceRequest[]          @relation("InvoiceRequestCreator")
  createdInvoices                Invoice[]                 @relation("InvoiceCreator")
  sales                    Sale[]
  sessions                 SessionCaisse[]
  stockMovements           StockMovement[]
  supplierDebtTransactions SupplierDebtTransaction[]
  supplierPayments         SupplierPayment[]
  userDepots               UserDepot[]
  depot                    Depot?                    @relation("DepotUsers", fields: [depotId], references: [id])

  @@unique([pin, depotId])
  @@index([depotId], map: "users_depot_id_fkey")
  @@map("users")
}

model Depot {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(100)
  code                String                @unique @db.VarChar(20)
  type                DepotType
  address             String                @db.Text
  city                String                @db.VarChar(50)
  phone               String?               @db.VarChar(20)
  email               String?               @db.VarChar(100)
  managerId           Int?                  @unique @map("manager_id")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  companyId           Int?                  @map("company_id")
  clients             Client[]
  company             Company?              @relation(fields: [companyId], references: [id])
  manager             User?                 @relation("DepotManager", fields: [managerId], references: [id])
  drivers             Driver[]
  expenses            Expense[]
  inventory           Inventory[]
  inventorySessions   InventorySession[]
  rebutRecords        RebutRecord[]
  returnRequests      ReturnRequest[]
  sales               Sale[]
  invoices              Invoice[]
  sessions            SessionCaisse[]
  receivedDocuments   StockDocument[]       @relation("Destinataire")
  emittedDocuments    StockDocument[]       @relation("Emetteur")
  stockMovements      StockMovement[]
  fromStockMovements  StockMovement[]       @relation("FromDepot")
  toStockMovements    StockMovement[]       @relation("ToDepot")
  suppliers           Supplier[]
  userDepots          UserDepot[]
  users               User[]                @relation("DepotUsers")
  productAssignments  ProductDepot[]
  produitDeCaisseAssignments ProduitDeCaisseDepot[]
  productDepotPrices  ProductDepotPrice[]

  @@index([companyId], map: "depots_company_id_fkey")
  @@map("depots")
}

model UserDepot {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  depotId   Int      @map("depot_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  depot     Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, depotId])
  @@index([userId], map: "user_depots_user_id_fkey")
  @@index([depotId], map: "user_depots_depot_id_fkey")
  @@map("user_depots")
}

model Company {
  id               Int           @id @default(autoincrement())
  raisonSociale    String        @db.VarChar(200)
  formeJuridique   String        @db.VarChar(50)
  activite         String?       @db.VarChar(200)
  dateCreation     DateTime?
  logoUrl          String?       @db.VarChar(255)
  brandColor       String?       @db.VarChar(20)
  statut           CompanyStatus @default(ACTIF)
  adresse          String?       @db.Text
  ville            String?       @db.VarChar(100)
  delegation       String?       @db.VarChar(100)
  gouvernorat      String?       @db.VarChar(100)
  codePostal       String?       @db.VarChar(10)
  telephone        String?       @db.VarChar(20)
  email            String?       @db.VarChar(100)
  siteWeb          String?       @db.VarChar(150)
  matriculeFiscal  String        @db.VarChar(50)
  rne              String        @db.VarChar(50)
  registreCommerce String?       @db.VarChar(50)
  tvaAssujetti     Boolean       @default(false)
  numeroTva        String?       @db.VarChar(50)
  tauxTva          Decimal       @default(19.00) @db.Decimal(5, 2)
  capitalSocial    Decimal       @default(0.000) @db.Decimal(14, 3)
  representantNom  String?       @db.VarChar(100)
  representantCin  String?       @db.VarChar(20)
  rib              String?       @db.VarChar(50)
  banque           String?       @db.VarChar(100)
  bic              String?       @db.VarChar(20)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  depots           Depot[]
  invoices         Invoice[]

  @@map("companies")
}

model ProductFamily {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(100)
  description      String?           @db.Text
  photo            String?           @db.VarChar(255)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  products         Product[]
  produitsDeCaisse ProduitDeCaisse[]

  @@map("product_families")
}

model Product {
  id                       Int                     @id @default(autoincrement())
  name                     String                  @db.VarChar(200)
  description              String?                 @db.Text
  barcode                  String?                 @unique @db.VarChar(50)
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  photo                    String?                 @db.VarChar(255)
  prix_vente_TTC           Decimal                 @map("prix_vente_ttc") @db.Decimal(10, 2)
  tva                      Decimal                 @default(19.00) @db.Decimal(5, 2)
  unite                    String                  @default("pcs") @db.VarChar(20)
  isStockable              Boolean                 @default(true) @map("is_stockable")
  originalProductId        Int?                    @map("original_product_id")
  isVrac                   Boolean                 @default(false) @map("is_vrac")
  displayIndex             Int?                    @map("display_index")
  bundlePrice              Decimal?                @map("bundle_price") @db.Decimal(10, 2)
  bundleSize               Int?                    @map("bundle_size")
  isWholesale              Boolean                 @default(false) @map("is_wholesale")
  minMargin                Decimal?                @map("min_margin") @db.Decimal(5, 2)
  requiresApproval         Boolean                 @default(false) @map("requires_approval")
  familleId                Int                     @map("famille_id")
  designation_legale       String?                 @map("designation_legale") @db.VarChar(200)
  prix_achat               Decimal?                @map("prix_achat") @db.Decimal(10, 3)
  conversionRatio          Decimal?                @map("conversion_ratio") @db.Decimal(10, 3)
  isVraguable              Boolean                 @default(false) @map("is_vraguable")
  prix_achat_vrac          Decimal?                @default(0.000) @map("prix_achat_vrac") @db.Decimal(10, 3)
  prix_vente_vrac          Decimal?                @default(0.00) @map("prix_vente_vrac") @db.Decimal(10, 2)
  clientProductPrices      ClientProductPrice[]
  invoiceLines             InvoiceLine[]
  inventory                Inventory[]
  inventoryItems           InventoryItem[]
  depotAssignments         ProductDepot[]
  depotPrices              ProductDepotPrice[]
  vracConversionsAsSource  ProductVracConversion[] @relation("SourceProductVrac")
  vracConversionsAsTarget  ProductVracConversion[] @relation("TargetProductVrac")
  famille                  ProductFamily           @relation(fields: [familleId], references: [id])
  originalProduct          Product?                @relation("VracProducts", fields: [originalProductId], references: [id])
  vracProducts             Product[]               @relation("VracProducts")
  originalProduitsDeCaisse ProduitDeCaisse[]       @relation("OriginalProduitDeCaisse")
  subProducts              ProduitDeCaisse[]       @relation("SubProducts")
  rebutRecords             RebutRecord[]
  returnItems              ReturnItem[]
  saleItems                SaleItem[]              @relation("ProductSaleItems")
  documentItems            StockDocumentItem[]
  stockMovements           StockMovement[]

  @@index([familleId], map: "products_famille_id_fkey")
  @@index([originalProductId], map: "products_original_product_id_fkey")
  @@map("products")
}

model ProductVracConversion {
  id              Int      @id @default(autoincrement())
  sourceProductId Int      @map("source_product_id")
  targetProductId Int      @map("target_product_id")
  conversionRatio Decimal  @map("conversion_ratio") @db.Decimal(10, 3)
  prix_vente_vrac Decimal? @map("prix_vente_vrac") @db.Decimal(10, 2)
  prix_achat_vrac Decimal? @map("prix_achat_vrac") @db.Decimal(10, 3)
  isStockable     Boolean  @default(true) @map("is_stockable")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  sourceProduct   Product  @relation("SourceProductVrac", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct   Product  @relation("TargetProductVrac", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, targetProductId], name: "unique_vrac_conversion")
  @@index([sourceProductId], map: "product_vrac_conversions_source_product_id_fkey")
  @@index([targetProductId], map: "product_vrac_conversions_target_product_id_fkey")
  @@map("product_vrac_conversions")
}

model ProductDepot {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  depotId   Int      @map("depot_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  depot     Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, depotId])
  @@index([productId], map: "product_depots_product_id_fkey")
  @@index([depotId], map: "product_depots_depot_id_fkey")
  @@map("product_depots")
}

model ProductDepotPrice {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  depotId        Int      @map("depot_id")
  prix_vente_TTC Decimal  @map("prix_vente_ttc") @db.Decimal(10, 3)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  depot          Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, depotId], name: "productId_depotId")
  @@index([productId], map: "product_depot_prices_product_id_fkey")
  @@index([depotId], map: "product_depot_prices_depot_id_fkey")
  @@map("product_depot_prices")
}



model ProduitDeCaisseDepot {
  id                Int             @id @default(autoincrement())
  produitDeCaisseId Int             @map("produit_de_caisse_id")
  depotId           Int             @map("depot_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  depot             Depot           @relation(fields: [depotId], references: [id], onDelete: Cascade)
  produitDeCaisse   ProduitDeCaisse @relation(fields: [produitDeCaisseId], references: [id], onDelete: Cascade)

  @@unique([produitDeCaisseId, depotId])
  @@index([produitDeCaisseId], map: "produit_de_caisse_depots_produit_de_caisse_id_fkey")
  @@index([depotId], map: "produit_de_caisse_depots_depot_id_fkey")
  @@map("produit_de_caisse_depots")
}

model ProduitDeCaisse {
  id                 Int           @id @default(autoincrement())
  name               String        @db.VarChar(200)
  productIds         String        @map("product_ids") @db.LongText
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  barcode            String?       @unique @db.VarChar(50)
  bundlePrice        Decimal?      @map("bundle_price") @db.Decimal(10, 2)
  bundleSize         Int?          @map("bundle_size")
  description        String?       @db.Text
  designation_legale String?       @map("designation_legale") @db.VarChar(200)
  displayIndex       Int?          @map("display_index")
  familleId          Int           @map("famille_id")
  initialStock       Decimal?      @map("initial_stock") @db.Decimal(10, 3)
  isStockable        Boolean       @default(true) @map("is_stockable")
  isVrac             Boolean       @default(false) @map("is_vrac")
  isVraguable        Boolean       @default(false) @map("is_vraguable")
  isWholesale        Boolean       @default(false) @map("is_wholesale")
  maxStock           Decimal?      @map("max_stock") @db.Decimal(10, 3)
  minStock           Decimal?      @map("min_stock") @db.Decimal(10, 3)
  originalProductId  Int?          @map("original_product_id")
  photo              String?       @db.VarChar(255)
  prix_achat         Decimal?      @map("prix_achat") @db.Decimal(10, 3)
  prix_vente_TTC     Decimal       @map("prix_vente_ttc") @db.Decimal(10, 2)
  tva                Decimal       @default(19.00) @db.Decimal(5, 2)
  unite              String        @default("pcs") @db.VarChar(20)
  parentProductId    Int?          @map("parent_product_id")
  depotAssignments   ProduitDeCaisseDepot[]
  famille            ProductFamily @relation(fields: [familleId], references: [id])
  originalProduct    Product?      @relation("OriginalProduitDeCaisse", fields: [originalProductId], references: [id])
  parentProduct      Product?      @relation("SubProducts", fields: [parentProductId], references: [id])

  @@index([familleId], map: "produits_de_caisse_famille_id_fkey")
  @@index([originalProductId], map: "produits_de_caisse_original_product_id_fkey")
  @@index([parentProductId], map: "produits_de_caisse_parent_product_id_fkey")
  @@map("produits_de_caisse")
}

model Inventory {
  id               Int      @id @default(autoincrement())
  depotId          Int      @map("depot_id")
  productId        Int      @map("product_id")
  quantity         Decimal  @default(0.000) @db.Decimal(10, 3)
  reservedQuantity Decimal  @default(0.000) @map("reserved_quantity") @db.Decimal(10, 3)
  lastUpdated      DateTime @updatedAt @map("last_updated")
  depot            Depot    @relation(fields: [depotId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])

  @@unique([depotId, productId])
  @@index([productId], map: "inventory_product_id_fkey")
  @@map("inventory")
}

model Client {
  id                  Int                     @id @default(autoincrement())
  code                String                  @unique @db.VarChar(20)
  firstName           String                  @map("first_name") @db.VarChar(50)
  lastName            String                  @map("last_name") @db.VarChar(50)
  email               String?                 @unique @db.VarChar(100)
  phone               String?                 @db.VarChar(20)
  address             String?                 @db.Text
  city                String?                 @db.VarChar(50)
  postalCode          String?                 @map("postal_code") @db.VarChar(10)
  birthday            DateTime?               @db.Date
  clientType          ClientType              @default(INDIVIDUAL) @map("client_type")
  loyaltyPoints       Int                     @default(0) @map("loyalty_points")
  totalSpent          Decimal                 @default(0.000) @map("total_spent") @db.Decimal(12, 3)
  favoriteProducts    String?                 @map("favorite_products") @db.Text
  allergies           String?                 @db.Text
  notes               String?                 @db.Text
  isActive            Boolean                 @default(true) @map("is_active")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  ageGroup            String?                 @map("age_group") @db.VarChar(20)
  allowDebt           Boolean                 @default(true) @map("allow_debt")
  currentDebt         Decimal                 @default(0.000) @map("current_debt") @db.Decimal(12, 3)
  maxDebt             Decimal?                @map("max_debt") @db.Decimal(12, 3)
  depotId             Int?                    @map("depot_id")
  matriculeFiscal     String?                 @map("matricule_fiscal") @db.VarChar(50)
  pictureUrl          String?                 @map("picture_url") @db.VarChar(255)
  debtTransactions    ClientDebtTransaction[]
  clientProductPrices ClientProductPrice[]
  depot               Depot?                  @relation(fields: [depotId], references: [id])
  sales               Sale[]
  invoices            Invoice[]
  stockDocuments      StockDocument[]

  @@index([depotId], map: "clients_depot_id_fkey")
  @@map("clients")
}

model ClientProductPrice {
  id             Int      @id @default(autoincrement())
  clientId       Int      @map("client_id")
  productId      Int      @map("product_id")
  prix_vente_TTC Decimal  @map("prix_vente_ttc") @db.Decimal(10, 3)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId], map: "client_product_prices_client_id_fkey")
  @@index([productId], map: "client_product_prices_product_id_fkey")
  @@map("client_product_prices")
}

model ClientDebtTransaction {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  saleId    Int?     @map("sale_id")
  amount    Decimal  @db.Decimal(12, 3)
  type      String   @db.VarChar(20)
  notes     String?  @db.Text
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id])
  sale      Sale?    @relation(fields: [saleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([clientId], map: "client_debt_transactions_client_id_fkey")
  @@index([saleId], map: "client_debt_transactions_sale_id_fkey")
  @@index([userId], map: "client_debt_transactions_user_id_fkey")
  @@map("client_debt_transactions")
}


model PaymentMethod {
  id                  Int               @id @default(autoincrement())
  name                String            @db.VarChar(50)
  type                PaymentMethodType
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  advancePaymentSales Sale[]            @relation("AdvancePaymentMethod")
  sales               Sale[]

  @@map("payment_methods")
}

model Sale {
  id                     Int                     @id @default(autoincrement())
  total                  Decimal                 @db.Decimal(10, 3)
  discount               Decimal                 @default(0.000) @db.Decimal(10, 3)
  finalTotal             Decimal                 @map("final_total") @db.Decimal(10, 3)
  paymentMethodId        Int?                    @map("payment_method_id")
  status                 SaleStatus              @default(PENDING)
  depotId                Int                     @map("depot_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  expectedDate           DateTime?               @map("expected_date")
  notes                  String?                 @db.Text
  clientId               Int?                    @map("client_id")
  userId                 Int                     @map("user_id")
  advancePayment         Decimal?                @default(0.000) @map("advance_payment") @db.Decimal(10, 3)
  advancePaymentDate     DateTime?               @map("advance_payment_date")
  advancePaymentMethodId Int?                    @map("advance_payment_method_id")
  advancePaymentNotes    String?                 @map("advance_payment_notes") @db.Text
  paymentType            SalePaymentType         @default(COMPTANT) @map("payment_type")
  sessionId              Int?                    @map("session_id")
  isWholesale            Boolean                 @default(false) @map("is_wholesale")
  dailyTicketNumber      String?                 @map("daily_ticket_number") @db.VarChar(50)
  isPrinted              Boolean                 @default(false) @map("is_printed")
  debtTransactions       ClientDebtTransaction[]
  invoiceRequests        InvoiceRequest[]
  invoices               Invoice[]
  items                  SaleItem[]
  advancePaymentMethod   PaymentMethod?          @relation("AdvancePaymentMethod", fields: [advancePaymentMethodId], references: [id])
  client                 Client?                 @relation(fields: [clientId], references: [id])
  depot                  Depot                   @relation(fields: [depotId], references: [id])
  paymentMethod          PaymentMethod?          @relation(fields: [paymentMethodId], references: [id])
  session                SessionCaisse?          @relation(fields: [sessionId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])

  @@unique([sessionId, dailyTicketNumber], map: "unique_session_daily_ticket")
  @@index([advancePaymentMethodId], map: "sales_advance_payment_method_id_fkey")
  @@index([clientId], map: "sales_client_id_fkey")
  @@index([depotId], map: "sales_depot_id_fkey")
  @@index([paymentMethodId], map: "sales_payment_method_id_fkey")
  @@index([sessionId], map: "sales_session_id_fkey")
  @@index([userId], map: "sales_user_id_fkey")
  @@map("sales")
}

model SaleItem {
  id               Int      @id @default(autoincrement())
  saleId           Int      @map("sale_id")
  productId        Int      @map("product_id")
  productName      String   @map("product_name") @db.VarChar(200)
  quantity         Decimal  @db.Decimal(10, 3)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(10, 2)
  total            Decimal  @db.Decimal(10, 2)
  discount         Decimal  @default(0.00) @db.Decimal(10, 2)
  bundlePrice      Decimal? @map("bundle_price") @db.Decimal(10, 2)
  bundleQuantity   Decimal? @map("bundle_quantity") @db.Decimal(10, 3)
  bundleSize       Int?     @map("bundle_size")
  isApproved       Boolean  @default(false) @map("is_approved")
  isWholesale      Boolean  @default(false) @map("is_wholesale")
  marginPercent    Decimal? @map("margin_percent") @db.Decimal(5, 2)
  requiresApproval Boolean  @default(false) @map("requires_approval")
  product          Product  @relation("ProductSaleItems", fields: [productId], references: [id])
  sale             Sale     @relation(fields: [saleId], references: [id])

  @@index([productId], map: "sale_items_product_id_fkey")
  @@index([saleId], map: "sale_items_sale_id_fkey")
  @@map("sale_items")
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  productId   Int               @map("product_id")
  depotId     Int               @map("depot_id")
  quantity    Decimal           @db.Decimal(10, 3)
  type        StockMovementType
  fromDepotId Int?              @map("from_depot_id")
  toDepotId   Int?              @map("to_depot_id")
