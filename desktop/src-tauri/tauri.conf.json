{
  "identifier": "com.samuraifood.pos",
  "productName": "Samurai Food",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../client/dist/samurai-food-offline/browser"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../client/public/favicon.ico"
    ],
    "resources": {
      "../resources/": "resources/",
      "../app-config.json": "app-config.json"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
